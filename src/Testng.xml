<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Full Regression" verbose="1">

    <test name="1 - Portal: Create Event" preserve-order="true">
        <classes>
            <class name="Tests.T01_PortalLogin">
                <methods>
                    <include name="CreateNewEvent"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="2 - Backoffice: Accept Event" preserve-order="true">
        <classes>
            <class name="Tests.T1_BackofficeLogin">
                <methods>
                    <include name="AcceptAndPublishLastEvent"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="3 - Portal: Create Opportunity" preserve-order="true">
        <classes>
            <class name="Tests.T01_PortalLogin">
                <methods>
                    <include name="CreateNewOpportunity"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="4 - Backoffice: Accept Opportunity" preserve-order="true">
        <classes>
            <class name="Tests.T1_BackofficeLogin">
                <methods>
                    <include name="AcceptAndPublishLastOpportunity"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="5 - Portal: Apply To Opportunity" preserve-order="true">
        <classes>
            <class name="Tests.T01_PortalLogin">
                <methods>
                    <include name="ApplyToTheLastOpportunity"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>