<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="MatloobSuite" parallel="false">

    <test name="PortalFlow" preserve-order="true">
        <classes>
            <class name="Tests.T01_PortalLogin">
                <methods>
                    <include name="CreateNewEvent"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="BackofficeFlow" preserve-order="true">
        <classes>
            <class name="Tests.T1_BackofficeLogin">
                <methods>
                    <include name="AcceptAndPublishLastEvent"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>